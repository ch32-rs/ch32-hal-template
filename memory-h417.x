/*
 * CH32H417QEU6 (QingKe V3F / boot core) linker memory map.
 *
 * Matches the dual-core partition used by ch32-hal's H417 examples:
 *
 *   0x00000000 +  64K  V3F flash load slot
 *   0x00010000 + ...   V5F flash (left unused in single-core mode)
 *   0x20100000 + 448K  zero-wait code/data/bss (V3F runs from here via highcode)
 *   0x20170000 +  32K  zero-wait stack
 *   0x20178000 +  32K  cross-core mailbox region
 *
 * Overrides the memory.x generated by ch32-metapac, which never declares a
 * region literally called `RAM` that qingke-rt's link.x needs.
 */
MEMORY
{
    CODE   (rx)  : ORIGIN = 0x00000000, LENGTH =  64K  /* USR boot alias; V3F load slot */
    USR    (rwx) : ORIGIN = 0x08000000, LENGTH =  64K
    SYS    (rwx) : ORIGIN = 0x1FFF0000, LENGTH =   56K
    VND    (r)   : ORIGIN = 0x1FFFF700, LENGTH =   256
    OPT    (rw)  : ORIGIN = 0x1FFFF800, LENGTH =   256
    RAM    (rwx) : ORIGIN = 0x20100000, LENGTH = 448K  /* zero-wait code/data/bss */
    STACK  (rwx) : ORIGIN = 0x20170000, LENGTH =  32K
    ITCM   (rwx) : ORIGIN = 0x200A0000, LENGTH =  128K
    SRAM_SHARED (rwx) : ORIGIN = 0x20178000, LENGTH = 32K
}

REGION_ALIAS("FLASH", CODE);
REGION_ALIAS("REGION_TEXT", CODE);
REGION_ALIAS("REGION_RODATA", CODE);
REGION_ALIAS("REGION_DATA", RAM);
REGION_ALIAS("REGION_BSS", RAM);
REGION_ALIAS("REGION_HEAP", RAM);
REGION_ALIAS("REGION_STACK", STACK);
